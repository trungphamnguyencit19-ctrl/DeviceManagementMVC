@model DeviceCategory
@{ ViewData["Title"] = "Delete category"; }
<h1>Delete category</h1><p>Delete category <strong>@Model.Name</strong>?</p><p class="text-muted">Categories with existing devices cannot be deleted.</p>
<form asp-action="Delete" method="post"><input type="hidden" asp-for="Id" /><button class="btn btn-danger">Delete</button> <a asp-action="Index" class="btn btn-secondary">Cancel</a></form>
