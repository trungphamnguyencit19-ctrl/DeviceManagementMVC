@model IEnumerable<DeviceCategory>
@{ ViewData["Title"] = "Categories"; }
<div class="d-flex justify-content-between align-items-center mb-3"><h1>Device categories</h1><a asp-action="Create" class="btn btn-primary">Add category</a></div>
<table class="table table-striped bg-white"><thead><tr><th>Name</th><th>Description</th><th>Actions</th></tr></thead><tbody>
@foreach (var item in Model) { <tr><td>@item.Name</td><td>@item.Description</td><td><a asp-action="Edit" asp-route-id="@item.Id">Edit</a> | <a asp-action="Delete" asp-route-id="@item.Id">Delete</a></td></tr> }
@if (!Model.Any()) { <tr><td colspan="3">No categories yet. Add one before creating a device.</td></tr> }
</tbody></table>
