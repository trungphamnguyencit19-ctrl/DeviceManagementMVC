<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Device Management</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
</head>
<body class="bg-light">
<nav class="navbar navbar-expand-lg navbar-dark bg-primary mb-4">
  <div class="container">
    <a class="navbar-brand" asp-controller="Devices" asp-action="Index">Device Management</a>
    <div class="navbar-nav">
      <a class="nav-link" asp-controller="Devices" asp-action="Index">Devices</a>
      <a class="nav-link" asp-controller="Categories" asp-action="Index">Categories</a>
      <a class="nav-link" asp-controller="Users" asp-action="Index">Users</a>
    </div>
  </div>
</nav>
<main class="container pb-5">
    @if (TempData["Error"] is string error) { <div class="alert alert-warning">@error</div> }
    @RenderBody()
</main>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
