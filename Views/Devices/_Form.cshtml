@model Device
<div asp-validation-summary="ModelOnly" class="text-danger"></div>
<div class="mb-3"><label asp-for="Name" class="form-label"></label><input asp-for="Name" class="form-control" /><span asp-validation-for="Name" class="text-danger"></span></div>
<div class="mb-3"><label asp-for="Code" class="form-label"></label><input asp-for="Code" class="form-control" /><span asp-validation-for="Code" class="text-danger"></span></div>
<div class="mb-3"><label asp-for="CategoryId" class="form-label"></label><select asp-for="CategoryId" asp-items="ViewBag.CategoryId" class="form-select"><option value="">-- Select category --</option></select><span asp-validation-for="CategoryId" class="text-danger"></span></div>
<div class="mb-3"><label asp-for="Status" class="form-label"></label><select asp-for="Status" asp-items="Html.GetEnumSelectList<DeviceStatus>()" class="form-select"></select><span asp-validation-for="Status" class="text-danger"></span></div>
<div class="mb-3"><label asp-for="DateOfEntry" class="form-label"></label><input asp-for="DateOfEntry" type="date" class="form-control" /><span asp-validation-for="DateOfEntry" class="text-danger"></span></div>
