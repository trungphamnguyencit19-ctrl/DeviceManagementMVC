@model Device
@{ ViewData["Title"] = "Delete device"; }
<h1>Delete device</h1>
<div class="alert alert-warning">Are you sure you want to delete this device?</div>
<dl class="row"><dt class="col-sm-3">Name</dt><dd class="col-sm-9">@Model.Name</dd><dt class="col-sm-3">Code</dt><dd class="col-sm-9">@Model.Code</dd><dt class="col-sm-3">Category</dt><dd class="col-sm-9">@Model.Category?.Name</dd></dl>
<form asp-action="Delete" method="post"><input type="hidden" asp-for="Id" /><button class="btn btn-danger">Delete</button> <a asp-action="Index" class="btn btn-secondary">Cancel</a></form>
