@model IEnumerable<AppUser>
@{ ViewData["Title"] = "Users"; }
<div class="d-flex justify-content-between align-items-center mb-3"><h1>Users</h1><a asp-action="Create" class="btn btn-primary">Add user</a></div>
<table class="table table-striped bg-white"><thead><tr><th>Full name</th><th>Email</th><th>Phone number</th><th>Actions</th></tr></thead><tbody>
@foreach (var item in Model) { <tr><td>@item.FullName</td><td>@item.Email</td><td>@item.PhoneNumber</td><td><a asp-action="Edit" asp-route-id="@item.Id">Edit</a> | <a asp-action="Delete" asp-route-id="@item.Id">Delete</a></td></tr> }
@if (!Model.Any()) { <tr><td colspan="4">No users found.</td></tr> }
</tbody></table>
